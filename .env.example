# Copie ce fichier en ".env" puis remplis les 3 valeurs.
# Le fichier .env est ignoré par git : il ne doit JAMAIS être publié.

# URL RPC Sepolia (Alchemy ou Infura), ex : https://eth-sepolia.g.alchemy.com/v2/xxxxxxxx
SEPOLIA_RPC_URL=

# Clé privée d'un compte MetaMask DÉDIÉ AUX TESTS (jamais ton compte principal)
PRIVATE_KEY=

# Clé API Etherscan (https://etherscan.io/myapikey)
ETHERSCAN_API_KEY=
