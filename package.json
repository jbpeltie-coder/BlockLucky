{
  "name": "blocklucky",
  "version": "1.0.0",
  "description": "BlockLucky - loterie décentralisée en smart contract Solidity (testnet Sepolia)",
  "private": true,
  "scripts": {
    "compile": "hardhat compile",
    "test": "hardhat test",
    "demo": "hardhat run scripts/demo.js",
    "deploy:sepolia": "hardhat run scripts/deploy.js --network sepolia",
    "verify:sepolia": "hardhat run scripts/verify.js --network sepolia",
    "frontend": "npx serve frontend",
    "web:install": "npm --prefix web install --legacy-peer-deps",
    "web": "npm --prefix web run dev",
    "test:contract": "hardhat test test/BlockLucky.test.js",
    "test:scale": "hardhat test test/BlockLucky.scale.test.js",
    "web:deploy": "cd web && NITRO_PRESET=netlify npm run build && npx -y netlify-cli@27.17.0 deploy --prod --no-build --dir dist --functions .netlify/functions-internal --site blocklucky-etherbay"
  },
  "license": "MIT",
  "devDependencies": {
    "@nomicfoundation/hardhat-chai-matchers": "^2.1.2",
    "@nomicfoundation/hardhat-ethers": "^3.1.3",
    "@nomicfoundation/hardhat-network-helpers": "^1.1.2",
    "@nomicfoundation/hardhat-verify": "^2.1.4",
    "chai": "^4.5.0",
    "dotenv": "^16.6.1",
    "ethers": "^6.17.0",
    "hardhat": "^2.29.2"
  }
}
